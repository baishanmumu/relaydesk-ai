# Required for chat and embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-3.5-turbo
MAX_TOKENS=1000

# Local services and optional travel database
QDRANT_URL=http://localhost:6333
QDRANT_KEY=
SQLITE_DB_PATH=./data/travel2.sqlite
DEMO_PASSENGER_ID=DEMO-001

# Optional integrations
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
WOOCOMMERCE_API_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
FORM_SUBMISSION_API_URL=
BLOG_SEARCH_API_URL=

# Remote human approval for web deployments. Without a key, the local CLI uses terminal approval.
GOHUMANLOOP_API_KEY=
GOHUMANLOOP_API_BASE_URL=http://127.0.0.1:9800/api

# Set true only when serving behind HTTPS.
SESSION_COOKIE_SECURE=false
